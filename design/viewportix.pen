                          "name": "Frame 4 · Kapanış",
                          "width": 420,
                          "layout": "vertical",
                          "gap": 8,
                          "children": [
                            {
                              "type": "frame",
                              "id": "jJenI",
                              "name": "Canvas Mock",
                              "clip": true,
                              "width": 420,
                              "height": 560,
