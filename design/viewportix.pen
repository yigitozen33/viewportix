                              "type": "text",
                              "id": "OsZaP",
                              "name": "Note",
                              "fill": "$ink/secondary",
                              "textGrowth": "fixed-width",
                              "width": 680,
                              "content": "Panel çubuğun 8 pt sağında yüzer; alt kenarı çubuğun alt kenarıyla hizalı, köken sol alt (çentiğin yeri). İçerik şekil yerleşince 60 ms gecikmeyle solarak gelir (satırlar 40 ms kademe). Karartma yok (modal değil); canvas kullanılabilir.",
                              "fontFamily": "$font/ui",
                              "fontSize": "$font/caption",
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
