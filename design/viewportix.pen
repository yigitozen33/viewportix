                                  "cornerRadius": [
                                    12,
                                    12,
                                    12,
                                    6
                                  ],
                                  "stroke": "$line",
                                  "strokeWidth": 1
                                },
                                {
                                  "type": "rectangle",
                                  "id": "Am9Vb",
                                  "x": 237.5,
                                  "y": 489,
                                  "name": "Seam",
                                  "fill": "$surface/header",
                                  "width": 3,
                                  "height": 31
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "uU3dN",
                              "name": "OptTitle",
                              "fill": "$ink/primary",
                              "content": "4 · Kapanış",
                              "fontFamily": "$font/ui",
                              "fontSize": "$font/body",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "gL8lI",
                              "name": "Note",
                              "fill": "$ink/secondary",
                              "textGrowth": "fixed-width",
                              "width": 420,
                              "content": "Esc, dışarı tık, ⌥⌘3 ya da göstergeye tekrar tık: içerik 80 ms söner, şekil aynı yoldan dile geri çekilir (200 ms, açılıştan hızlı). Yarıda tekrar tıklanırsa o anki boyuttan geri döner (kesilebilir).",
                              "fontFamily": "$font/ui",
                              "fontSize": "$font/caption",
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "WgvVc",
                      "name": "Spec",
                      "width": 1700,
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "QIroX",
                          "name": "N",
                          "fill": "$ink/secondary",
                          "textGrowth": "fixed-width",
                          "width": 1700,
                          "content": "· Ad (Emil · animation-vocabulary): Morph — bir şekil başka şekle dönüşür (Dynamic Island). Yakınları: Origin-aware animation (panel tetikleyicisinden büyür), Shared element transition (öğe yer değiştirip dönüşür), Spatial consistency (aynı yoldan geri döner).",
                          "fontFamily": "$font/ui",
                          "fontSize": "$font/caption",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "j2fM1",
                          "name": "N",
                          "fill": "$ink/secondary",
                          "textGrowth": "fixed-width",
                          "width": 1700,
                          "content": "· Eğri: spring, sönümlü (damping 1.0, response 0.32 ≈ açılış 300 ms algı); kapanış 200 ms (asimetrik: sistem yanıtı hızlı). Esneme yok (araç paneli, oyun değil). SwiftUI: matchedGeometryEffect(id: \"resources\") + .spring(response: 0.32, dampingFraction: 1).",
                          "fontFamily": "$font/ui",
                          "fontSize": "$font/caption",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "r7qbn",
                          "name": "N",
                          "fill": "$ink/secondary",
                          "textGrowth": "fixed-width",
                          "width": 1700,
                          "content": "· Kurallar: sıfırdan büyüme yok (dil zaten şekil); içerik şekilden sonra, şekil içerikten önce kapanır; kesilebilir (o anki değerden); karartma yok (Apple: paralel, engellemeyen panel); her açılışta aynı köken (sol alt = çentik). Sık kullanılır → kısa tut.",
                          "fontFamily": "$font/ui",
                          "fontSize": "$font/caption",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "pGtQB",
                          "name": "N",
                          "fill": "$ink/secondary",
                          "textGrowth": "fixed-width",
                          "width": 1700,
                          "content": "· Hareketi azalt: morph yok; dil yerinde kalır, panel 150 ms solarak açılır / kapanır.",
                          "fontFamily": "$font/ui",
                          "fontSize": "$font/caption",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Vk3oG",
                          "name": "N",
                          "fill": "$ink/secondary",
                          "textGrowth": "fixed-width",
                          "width": 1700,
                          "content": "· Yer: çubuk kenarı ile pencere sağ kenarı arasında 380 + 8 sığmıyorsa (dar pencere, ray açık) panel çubuğun üstüne, çentiğin üstünde sağa hizalı açılır; morph yine çentikten.",
                          "fontFamily": "$font/ui",
                          "fontSize": "$font/caption",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
